# Copy to .env and change what you need. Defaults run everything locally.

# ---- Which models to use --------------------------------------------
# Local (default): everything on your PC through Ollama.
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=ollama
# Cloud, like the live demo: Groq first, then Cloudflare, then OpenRouter.
# Needs: uv sync --extra cloud
# LLM_PROVIDER=groq,cloudflare,openrouter
# EMBEDDINGS_PROVIDER=cloudflare
# Other choices: LLM_PROVIDER=gemini (uv sync --extra gemini),
# EMBEDDINGS_PROVIDER=huggingface (uv sync --extra hf) or gemini.

# ---- Ollama (local) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4:tiny-h
OLLAMA_EMBED_MODEL=granite-embedding:278m

# ---- API keys (never share or commit these) -------------------------
# Groq: console.groq.com > API Keys
GROQ_API_KEY=
# Cloudflare: dash.cloudflare.com > AI > Workers AI > Use REST API
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# OpenRouter: openrouter.ai > Keys
OPENROUTER_API_KEY=
# Gemini: aistudio.google.com/apikey. Note: Google's terms allow only paid
# Gemini for apps offered to users in the EEA, UK or Switzerland.
GOOGLE_API_KEY=

# ---- Optional model overrides (defaults are in config.py) ------------
# GROQ_MODEL=openai/gpt-oss-120b
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
# OPENROUTER_MODEL=openrouter/free
# GEMINI_MODEL=gemini-flash-latest
# HF_EMBED_MODEL=ibm-granite/granite-embedding-278m-multilingual

# Optional: hide Hugging Face's harmless symlink warning on Windows.
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
