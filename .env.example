# Copy to .env and change what you need. Defaults run everything locally.

# Which model writes the answers: ollama | gemini
LLM_PROVIDER=ollama
# Which model turns text into vectors: ollama | huggingface | gemini
EMBEDDINGS_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4:tiny-h
OLLAMA_EMBED_MODEL=granite-embedding:278m

# Gemini (free API key from https://aistudio.google.com/apikey)
# Needs: uv sync --extra gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-2

# Hugging Face (Granite embeddings on CPU). Needs: uv sync --extra hf
HF_EMBED_MODEL=ibm-granite/granite-embedding-278m-multilingual
# Optional: hide Hugging Face's harmless symlink warning on Windows.
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
